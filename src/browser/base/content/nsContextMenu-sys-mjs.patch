+  /** Add a full-page action only to the page menu, preserving selection menus. */
+  showTranslatePageItem() {
+    const item = this.document.getElementById("context-zen-translate-page");
+    item.hidden = true;
+    item.disabled = true;
+    if (
+      !this.inTabBrowser ||
+      this.inAboutDevtoolsToolbox ||
+      this.inWebExtBrowser ||
+      this.inFrame ||
+      this.inSyntheticDoc ||
+      this.isContentSelected ||
+      this.isTextSelected ||
+      this.onLink ||
+      this.onPlainTextLink ||
+      this.onImage ||
+      this.onCanvas ||
+      this.onVideo ||
+      this.onAudio ||
+      this.onTextInput ||
+      this.onEditable ||
+      this.window.browsingContext.isDocumentPiP
+    ) {
+      return;
+    }
+    this.#pageTranslations = new lazy.ZenPageTranslations(
+      this.browser,
+      this.actor.manager,
+      item,
+      () => this.showHideSeparators(item.parentNode)
+    );
+    this.#pageTranslations.init().catch(console.error);
+  }
+
+  toggleTranslatePage() {
+    return this.#pageTranslations?.toggle() ?? Promise.resolve(false);
+  }
