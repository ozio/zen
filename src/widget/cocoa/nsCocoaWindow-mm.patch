+// NSEvent has no public magnify-event factory. This privileged Gecko testing
+// API supplies the same accessors used by the real Cocoa router, without OS
+// event posting or private multitouch APIs. It does not emulate hardware.
+@interface ZenTestMagnifyEvent : NSEvent {
+ @public
+  NSWindow* mTestWindow;
+  NSPoint mTestLocation;
+  CGFloat mTestMagnification;
+  NSEventPhase mTestPhase;
+  NSEventModifierFlags mTestModifiers;
+}
+@end
+
+@implementation ZenTestMagnifyEvent
+- (NSEventType)type {
+  return NSEventTypeMagnify;
+}
+- (NSWindow*)window {
+  return mTestWindow;
+}
+- (NSPoint)locationInWindow {
+  return mTestLocation;
+}
+- (CGFloat)magnification {
+  return mTestMagnification;
+}
+- (NSEventPhase)phase {
+  return mTestPhase;
+}
+- (NSEventModifierFlags)modifierFlags {
+  return mTestModifiers;
+}
+- (NSTimeInterval)timestamp {
+  return [[NSProcessInfo processInfo] systemUptime];
+}
+@end
+
+nsresult nsCocoaWindow::SynthesizeNativeTouchPadPinch(
+    TouchpadGesturePhase aEventPhase, float aScale, LayoutDeviceIntPoint aPoint,
+    int32_t aModifierFlags) {
+  NS_OBJC_BEGIN_TRY_BLOCK_RETURN;
+
+  if (!mChildView || !mWindow || !std::isfinite(aScale) || aScale <= 0) {
+    return NS_ERROR_INVALID_ARG;
+  }
+  NSEventPhase phase;
+  switch (aEventPhase) {
+    case PHASE_BEGIN:
+      phase = NSEventPhaseBegan;
+      mSyntheticPinchScale = aScale;
+      break;
+    case PHASE_UPDATE:
+      phase = NSEventPhaseChanged;
+      break;
+    case PHASE_END:
+      phase = NSEventPhaseEnded;
+      break;
+    default:
+      return NS_ERROR_INVALID_ARG;
+  }
+  RefPtr<nsCocoaWindow> widget(this);
+  nsAutoRetainCocoaObject windowGrip(mWindow);
+  NSPoint point =
+      nsCocoaUtils::DevPixelsToCocoaPoints(aPoint, BackingScaleFactor());
+  point.y = nsCocoaUtils::FlippedScreenY(point.y);
+  ZenTestMagnifyEvent* event = [[ZenTestMagnifyEvent alloc] init];
+  if (!event) return NS_ERROR_FAILURE;
+  auto releaseEvent = MakeScopeExit([&]() { [event release]; });
+  event->mTestWindow = mWindow;
+  event->mTestLocation = [mWindow convertPointFromScreen:point];
+  event->mTestMagnification = aScale / mSyntheticPinchScale - 1.0;
+  event->mTestPhase = phase;
+  event->mTestModifiers =
+      nsCocoaUtils::ConvertWidgetModifiersToMacModifierFlags(
+          static_cast<nsIWidget::NativeModifiers>(aModifierFlags));
+  mSyntheticPinchScale = aScale;
+  if (!RoutePiPTrackpadEvent(event) && mChildView) {
+    [mChildView magnifyWithEvent:event];
+  }
+  return NS_OK;
+
+  NS_OBJC_END_TRY_BLOCK_RETURN(NS_ERROR_FAILURE);
+}
