+void nsCocoaWindow::UnregisterPiPTrackpad() {
+  FinishPiPTrackpadCursor(false);
+  if (sPiPMouseOwner == this) sPiPMouseOwner = nullptr;
+  if (sPiPTrackpadOwner == this) {
+    sPiPTrackpadOwner = nullptr;
+    sPiPTrackpadFingers = false;
+  }
+  if (mIsPiPTrackpadWindow) {
+    mIsPiPTrackpadWindow = false;
+    if (--sPiPTrackpadWindows == 0) {
+      if (sPiPTrackpadGlobalMonitor) {
+        [NSEvent removeMonitor:sPiPTrackpadGlobalMonitor];
+        sPiPTrackpadGlobalMonitor = nil;
+      }
+      if (sPiPDeactivateObserver) {
+        [[NSNotificationCenter defaultCenter]
+            removeObserver:sPiPDeactivateObserver];
+        sPiPDeactivateObserver = nil;
+      }
+      Preferences::UnregisterCallback(PiPInputEnabledChanged,
+                                      "zen.pip.trackpad.enabled");
+    }
+  }
+}
+
+void nsCocoaWindow::FinishPiPTrackpadCursor(bool aRelocate) {
+  if (sPiPCursorOwner != this) return;
+  if (aRelocate && sPiPCursorPanned && mWindow && !mOnDestroyCalled) {
+    const NSRect frame = [mWindow frame];
+    NSPoint target = NSMakePoint(
+        sPiPCursorStart.x + frame.origin.x - sPiPCursorFrame.origin.x,
+        sPiPCursorStart.y + frame.origin.y - sPiPCursorFrame.origin.y);
+    target.x = std::clamp<CGFloat>(target.x, NSMinX(frame), NSMaxX(frame) - 1);
+    target.y = std::clamp<CGFloat>(target.y, NSMinY(frame), NSMaxY(frame) - 1);
+    CGWarpMouseCursorPosition(
+        CGPointMake(target.x, nsCocoaUtils::FlippedScreenY(target.y)));
+  }
+  if (sPiPCursorHidden) CGDisplayShowCursor(kCGDirectMainDisplay);
+  sPiPCursorHidden = false;
+  sPiPCursorPanned = false;
+  sPiPCursorOwner = nullptr;
+  if (RefPtr<dom::Document> document = GetDocument()) {
+    if (RefPtr<dom::Element> root = document->GetRootElement()) {
+      root->UnsetAttr(kNameSpaceID_None, NS_Atomize("zen-pip-cursor-hidden"),
+                      false);
+    }
+  }
+}
+
+void nsCocoaWindow::CancelPiPInput() {
+  RefPtr<nsCocoaWindow> trackpad(sPiPTrackpadOwner);
+  RefPtr<nsCocoaWindow> mouse(sPiPMouseOwner);
+  sPiPTrackpadOwner = nullptr;
+  sPiPTrackpadFingers = false;
+  sPiPMouseOwner = nullptr;
+  const NSPoint point = [NSEvent mouseLocation];
+  if (trackpad) {
+    trackpad->FinishPiPTrackpadCursor(false);
+    trackpad->DispatchPiPTrackpadEvent(PiPTrackpadPhase::Cancel, nil, point);
+  }
+  if (mouse)
+    mouse->DispatchPiPTrackpadEvent(PiPTrackpadPhase::Cancel, nil, point);
+}
+
+void nsCocoaWindow::BeginPiPMouseDrag() {
+  RefPtr<nsCocoaWindow> widget(this);
+  if (!mIsPiPTrackpadWindow || sPiPMouseOwner == this) return;
+  NSEvent* event = [NSApp currentEvent];
+  if (([event type] != NSEventTypeLeftMouseDown &&
+       [event type] != NSEventTypeLeftMouseDragged) ||
+      !([NSEvent pressedMouseButtons] & 1) ||
+      ([event modifierFlags] &
+       (NSEventModifierFlagCommand | NSEventModifierFlagControl |
+        NSEventModifierFlagOption | NSEventModifierFlagShift)))
+    return;
+  CancelPiPInput();
+  if (DispatchPiPTrackpadEvent(PiPTrackpadPhase::MouseStart, event,
+                               [NSEvent mouseLocation]) &&
+      !mOnDestroyCalled) {
+    sPiPMouseOwner = this;
+  }
+}
+
+void nsCocoaWindow::FinishPiPMouseDrag(NSEvent* aEvent) {
+  if (!sPiPMouseOwner || ([aEvent type] != NSEventTypeLeftMouseUp &&
+                          ([NSEvent pressedMouseButtons] & 1)))
+    return;
+  RefPtr<nsCocoaWindow> owner(sPiPMouseOwner);
+  sPiPMouseOwner = nullptr;
+  const auto modifiers = [NSEvent modifierFlags];
+  const bool cancel =
+      modifiers & (NSEventModifierFlagCommand | NSEventModifierFlagControl |
+                   NSEventModifierFlagOption | NSEventModifierFlagShift);
+  owner->DispatchPiPTrackpadEvent(
+      cancel ? PiPTrackpadPhase::Cancel : PiPTrackpadPhase::MouseEnd, aEvent,
+      [NSEvent mouseLocation]);
+}
+
+bool nsCocoaWindow::DispatchPiPTrackpadEvent(PiPTrackpadPhase aPhase,
+                                             NSEvent* aEvent,
+                                             NSPoint aScreenPoint) {
+  RefPtr<nsCocoaWindow> widget(this);
+  RefPtr<dom::Document> document = GetDocument();
+  if (!document || !document->NodePrincipal()->IsSystemPrincipal() ||
+      !document->GetDocumentURI() || !mWindow || !mChildView ||
+      mInFullScreenMode ||
+      !Preferences::GetBool("zen.pip.trackpad.enabled", true)) {
+    return false;
+  }
+  nsAutoCString spec;
+  document->GetDocumentURI()->GetSpec(spec);
+  if (!spec.EqualsLiteral(
+          "chrome://global/content/pictureinpicture/player.xhtml")) {
+    return false;
+  }
+  RefPtr<dom::Element> root = document->GetRootElement();
+  nsAutoString windowType;
+  if (!root || !root->GetAttr(nsGkAtoms::windowtype, windowType) ||
+      !windowType.EqualsLiteral("Toolkit:PictureInPicture")) {
+    return false;
+  }
+  nsCOMPtr<nsPIDOMWindowInner> inner = document->GetInnerWindow();
+  if (!inner || inner->GetExtantDoc() != document) {
+    return false;
+  }
+  if (aPhase == PiPTrackpadPhase::Pan || aPhase == PiPTrackpadPhase::Pinch ||
+      aPhase == PiPTrackpadPhase::MouseMove ||
+      aPhase == PiPTrackpadPhase::MouseEnd) {
+    nsAutoString claim;
+    RefPtr<nsAtom> attr = NS_Atomize("zen-pip-trackpad-capture");
+    if (!root->GetAttr(kNameSpaceID_None, attr, claim) ||
+        !((aPhase == PiPTrackpadPhase::MouseMove ||
+           aPhase == PiPTrackpadPhase::MouseEnd)
+              ? claim.EqualsLiteral("mouse")
+          : sPiPTrackpadPinch ? claim.EqualsLiteral("pinch")
+                              : claim.EqualsLiteral("pan"))) {
+      return false;
+    }
+  }
+  nsAutoString name;
+  switch (aPhase) {
+    case PiPTrackpadPhase::Start:
+      name.AssignLiteral("MozZenPiPTrackpadStart");
+      break;
+    case PiPTrackpadPhase::Pan:
+      name.AssignLiteral("MozZenPiPTrackpadPan");
+      break;
+    case PiPTrackpadPhase::Pinch:
+      name.AssignLiteral("MozZenPiPTrackpadPinch");
+      break;
+    case PiPTrackpadPhase::End:
+      name.AssignLiteral("MozZenPiPTrackpadEnd");
+      break;
+    case PiPTrackpadPhase::Cancel:
+      name.AssignLiteral("MozZenPiPTrackpadCancel");
+      break;
+    case PiPTrackpadPhase::MouseStart:
+      name.AssignLiteral("MozZenPiPMouseStart");
+      break;
+    case PiPTrackpadPhase::MouseMove:
+      name.AssignLiteral("MozZenPiPMouseMove");
+      break;
+    case PiPTrackpadPhase::MouseEnd:
+      name.AssignLiteral("MozZenPiPMouseEnd");
+      break;
+  }
+  nsAutoString modifiers;
+  NSEventModifierFlags flags = [aEvent modifierFlags];
+  if ([aEvent type] == NSEventTypeMagnify ||
+      (flags & NSEventModifierFlagControl)) {
+    modifiers.AppendLiteral("Control ");
+  }
+  if (flags & NSEventModifierFlagCommand) modifiers.AppendLiteral("Meta ");
+  if (flags & NSEventModifierFlagOption) modifiers.AppendLiteral("Alt ");
+  if (flags & NSEventModifierFlagShift) modifiers.AppendLiteral("Shift ");
+  const NSPoint local =
+      [mChildView convertPoint:[mWindow convertPointFromScreen:aScreenPoint]
+                      fromView:nil];
+  const double dx =
+      aPhase == PiPTrackpadPhase::Pan ? -[aEvent scrollingDeltaX] : 0;
+  const double dy = aPhase == PiPTrackpadPhase::Pinch ? [aEvent magnification]
+                    : aPhase == PiPTrackpadPhase::Pan
+                        ? -[aEvent scrollingDeltaY]
+                        : 0;
+  // A dedicated chrome event avoids APZ/remote hit-testing against coordinates
+  // which are now outside the moving window. It never reaches a web document.
+  RefPtr<dom::WheelEvent> event =
+      new dom::WheelEvent(document, nullptr, nullptr);
+  event->InitWheelEvent(
+      name, true, true, nullptr, 0, NSToIntRound(aScreenPoint.x),
+      NSToIntRound(nsCocoaUtils::FlippedScreenY(aScreenPoint.y)),
+      NSToIntRound(local.x), NSToIntRound(local.y), 0, nullptr, modifiers, dx,
+      dy, 0, 0);
+  event->SetTrusted(true);
+  event->WidgetEventPtr()->mFlags.mOnlyChromeDispatch = true;
+  IgnoredErrorResult error;
+  document->DispatchEvent(*event, error);
+  return !error.Failed() && event->DefaultPrevented();
+}
+
+bool nsCocoaWindow::RoutePiPTrackpadEvent(NSEvent* aEvent, bool aGlobal) {
+  const NSEventType type = [aEvent type];
+  if (!aGlobal && type == NSEventTypeKeyDown && [aEvent keyCode] == 53) {
+    CancelPiPInput();  // Local Escape cancels a native drag/tracking loop.
+    return false;
+  }
+  const bool pinch = type == NSEventTypeMagnify;
+  const bool scroll =
+      type == NSEventTypeScrollWheel && [aEvent hasPreciseScrollingDeltas];
+  const bool click = type == NSEventTypeLeftMouseDown ||
+                     type == NSEventTypeRightMouseDown ||
+                     type == NSEventTypeOtherMouseDown;
+  if (type == NSEventTypeLeftMouseUp) FinishPiPMouseDrag(aEvent);
+  if (!pinch && !scroll && !click) return false;
+
+  const NSPoint point = aGlobal ? [NSEvent mouseLocation]
+                                : nsCocoaUtils::ScreenLocationForEvent(aEvent);
+  auto cancelOwner = [&](bool aStopMotion = true) {
+    RefPtr<nsCocoaWindow> owner(sPiPTrackpadOwner);
+    sPiPTrackpadOwner = nullptr;
+    sPiPTrackpadFingers = false;
+    if (owner && aStopMotion) {
+      owner->FinishPiPTrackpadCursor(false);
+      owner->DispatchPiPTrackpadEvent(PiPTrackpadPhase::Cancel, aEvent, point);
+    }
+  };
+  if (click || [NSEvent pressedMouseButtons]) {
+    cancelOwner();
+    return false;
+  }
+  const NSEventPhase phase = [aEvent phase];
+  const bool momentum = scroll && [aEvent momentumPhase] != NSEventPhaseNone;
+  if (momentum) {
+    // After Ended, only this original owner may receive the OS tail. JS owns
+    // the coast, so discard the native tail instead of starting it twice.
+    const bool owned = sPiPTrackpadOwner && !sPiPTrackpadPinch;
+    if (owned && sPiPTrackpadFingers) {
+      // A momentum tail also proves fingers were released, even if AppKit did
+      // not deliver a separate terminal finger event to this application.
+      RefPtr<nsCocoaWindow> owner(sPiPTrackpadOwner);
+      sPiPTrackpadFingers = false;
+      owner->DispatchPiPTrackpadEvent(PiPTrackpadPhase::End, aEvent, point);
+      owner->FinishPiPTrackpadCursor(true);
+    }
+    if ([aEvent momentumPhase] & (NSEventPhaseEnded | NSEventPhaseCancelled)) {
+      sPiPTrackpadOwner = nullptr;
+      sPiPTrackpadFingers = false;
+    }
+    return owned;
+  }
+  if (phase == NSEventPhaseNone ||
+      (scroll && ([aEvent modifierFlags] & NSEventModifierFlagControl))) {
+    cancelOwner(sPiPTrackpadFingers);
+    return false;  // Preserve ordinary wheel / Control-wheel behavior.
+  }
+  const bool starting =
+      (phase & NSEventPhaseMayBegin) ||
+      ((phase & NSEventPhaseBegan) &&
+       (!sPiPTrackpadOwner || sPiPTrackpadBegan || pinch != sPiPTrackpadPinch));
+  if (starting) {
+    cancelOwner(sPiPTrackpadFingers);
+    if (sPiPMouseOwner) CancelPiPInput();
+    // AppKit sends magnify to the key window. Resolve the visible window under
+    // the initial pointer instead; never activate it or move keyboard focus.
+    NSInteger number = [NSWindow windowNumberAtPoint:point
+                         belowWindowWithWindowNumber:0];
+    NSWindow* window = [NSApp windowWithWindowNumber:number];
+    if (!window || ![window isVisible] || [window isMiniaturized] ||
+        [window attachedSheet])
+      return false;
+    NSView* view =
+        [window.contentView hitTest:[window convertPointFromScreen:point]];
+    while (view && ![view isKindOfClass:[ChildView class]])
+      view = view.superview;
+    if (!view) return false;
+    RefPtr<nsCocoaWindow> candidate(
+        static_cast<nsCocoaWindow*>([(ChildView*)view widget]));
+    if (!candidate ||
+        !candidate->DispatchPiPTrackpadEvent(PiPTrackpadPhase::Start, aEvent,
+                                             point) ||
+        !candidate->mChildView || candidate->mOnDestroyCalled)
+      return false;
+    sPiPTrackpadOwner = candidate;
+    sPiPTrackpadPinch = pinch;
+    sPiPTrackpadFingers = true;
+    sPiPTrackpadBegan = phase & NSEventPhaseBegan;
